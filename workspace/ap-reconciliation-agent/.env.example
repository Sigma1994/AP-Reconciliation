# AI Engine selection: "ollama" (local 8 GB RAM default) or "gemini" (cloud API)
AP_AI_ENGINE=ollama

# Local Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_NUM_CTX=4096
OLLAMA_VISION_KEEP_ALIVE=30s
OLLAMA_VISION_TIMEOUT=180
OLLAMA_TEXT_TIMEOUT=90

# Optional Gemini Cloud configuration (used when AP_AI_ENGINE=gemini)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# Set to 1 for deterministic CI / offline mode without an external LLM daemon
USE_DETERMINISTIC_LLM=0

# Deterministic Kenyan AP policy thresholds
RECON_MAX_VARIANCE_PCT=1.5
RECON_ABS_TOL_KES=500
RECON_ABS_TOL_USD=5
HIGH_VALUE_KES=150000
HIGH_VALUE_USD=1000
INTAKE_MAX_SIDE=1344
INTAKE_AUTO_ACCEPT=0

# Storage paths
AP_DB_PATH=data/ap.db
AP_CHECKPOINT_DB_PATH=data/ap_checkpoints.db
AP_UPLOAD_DIR=data/uploads
